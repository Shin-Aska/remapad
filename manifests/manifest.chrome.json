{
  "manifest_version": 3,
  "name": "Remapad — Gamepad Browser Controller",
  "short_name": "Remapad",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Navigate streaming sites with a gamepad. Map buttons, customize site profiles, and control playback, scrolling, and navigation.",
  "homepage_url": "https://gitlab.com/ShinAska/remapad",
  "author": "Richard Louie Orilla",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Remapad Gamepad Controller"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "default_locale": "en_US"
}
