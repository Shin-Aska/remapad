{
  "manifest_version": 3,
  "name": "Remapad — Gamepad Browser Controller",
  "short_name": "Remapad",
  "version": "1.0.2",
  "description": "Navigate streaming sites with a gamepad. Map buttons, customize site profiles, and control playback, scrolling, and navigation.",
  "homepage_url": "https://gitlab.com/ShinAska/remapad",
  "author": "Richard Louie Orilla",
  "developer": {
    "name": "Richard Louie Orilla",
    "url": "https://www.richardorilla.website"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Remapad Gamepad Controller"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background/service_worker.js"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://netflix.com/*",
    "*://www.netflix.com/*",
    "*://primevideo.com/*",
    "*://www.primevideo.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "remapad@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "default_locale": "en_US"
}
