{
  "manifest_version": 3,
  "name": "Remapad — Gamepad Browser Controller",
  "short_name": "Remapad",
  "version": "1.0.0",
  "description": "Navigate streaming sites (Netflix, YouTube, Prime Video, Twitch, Disney+, Hulu, Max) with your gamepad controller. Map buttons, customize profiles, and enjoy a cinematic browsing experience.",
  "author": "Remapad",

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "96":  "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Remapad Gamepad Controller"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "background": {
    "scripts": ["background/service_worker.js"],
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": ["content/gamepad_blocker.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "shared/language-detector.js",
        "shared/keyboard.js",
        "content/modules/constants.js",
        "content/modules/utils.js",
        "content/modules/messaging-client.js",
        "content/modules/controller-style.js",
        "content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "*://*/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "remapad@extension",
      "strict_min_version": "128.0"
    }
  },

  "default_locale": "en_US"
}
